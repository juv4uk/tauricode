{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauricode",
  "version": "0.1.1",
  "identifier": "io.tauricode.desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "windows": [
      {
        "title": "Tauricode — Ecosystem Snapshot",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
